# ---- App ----
APP_NAME=AgriScan
APP_ENV=production
APP_KEY=                       # run: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-render-backend.example.com
FRONTEND_URL=https://your-app.vercel.app

# ---- Primary database: Neon PostgreSQL (use the DIRECT host for migrations, POOLED host for runtime) ----
DB_CONNECTION=pgsql
DB_HOST=ep-xxxx.region.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=change-me
DB_SSLMODE=require

# ---- Optional secondary PostgreSQL (disabled by default; see docs in later phase) ----
DB_SECONDARY_ENABLED=false
DB_SECONDARY_HOST=
DB_SECONDARY_PORT=5432
DB_SECONDARY_DATABASE=
DB_SECONDARY_USERNAME=
DB_SECONDARY_PASSWORD=

# ---- Sanctum / CORS ----
SANCTUM_STATEFUL_DOMAINS=
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# ---- Accounts and quotas ----
DEFAULT_ACCOUNT_QUOTA_BYTES=1073741824
QUOTA_WARNING_THRESHOLDS=75,90,100
MAX_UPLOAD_KB=8192
SEED_ADMIN_NAME="AgriScan Admin"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---- Queue / cache / session (database-backed; no paid Redis required) ----
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
LOG_CHANNEL=stderr
LOG_LEVEL=info

# ---- Mail (password reset) ----
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ---- AI providers (wired in Phase 2) ----
AI_PROVIDER_PRIORITY=huggingface,grok
HUGGINGFACE_ENABLED=true
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=
HUGGINGFACE_ENDPOINT=
GROK_ENABLED=false
GROK_API_KEY=
GROK_MODEL=
GROK_ENDPOINT=

# ---- Object storage (wired in Phase 2) ----
STORAGE_PRIMARY=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_SECONDARY_ENABLED=false
S3_SECONDARY_KEY=
S3_SECONDARY_SECRET=
S3_SECONDARY_BUCKET=
S3_SECONDARY_ENDPOINT=
S3_SECONDARY_REGION=auto
