# ============================================================================
# AgriScan backend (Laravel). Placeholders only: never commit real values.
# ============================================================================
APP_NAME=AgriScan
APP_ENV=production
APP_KEY=                      # generate with: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-render-service.onrender.com
LOG_CHANNEL=stderr
LOG_LEVEL=info

# ---- Browser sessions / optional CORS ----------------------------------------
# The Blade UI is served by this app (same origin), so no CORS is needed.
# Only list origins here if another website calls the JSON API under /api/v1.
CORS_ALLOWED_ORIGINS=

# ---- Primary database: Neon PostgreSQL (free) --------------------------------
# Runtime: use the POOLED connection string (host contains "-pooler") and DB_POOLED is informational only.
DB_CONNECTION=pgsql
DB_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DB_POOLED=true
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10
# Optional: your Neon plan's storage limit in bytes. Leave EMPTY if unsure; the dashboard then shows "Unknown".
PRIMARY_DB_CAPACITY_BYTES=
# Optional: lets the dashboard read the project's size limit from the Neon API.
NEON_API_KEY=
NEON_PROJECT_ID=
DB_WARN_PERCENT=80

# ---- Optional secondary PostgreSQL (explicit recovery + pending-operation journal only) ----
DB_SECONDARY_ENABLED=false
DB_SECONDARY_URL=
DB_SECONDARY_SSLMODE=require

# ---- Auth ---------------------------------------------------------------------
SANCTUM_TOKEN_MINUTES=43200
MAIL_MAILER=log               # use smtp + MAIL_* for real password-reset emails
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@your-domain.example
MAIL_FROM_NAME=AgriScan

# ---- AI providers (order = priority; unconfigured ones are skipped) ------------
AI_PROVIDER_PRIORITY=huggingface,grok
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_BACKOFF_MS=500
AI_MAX_BACKOFF_MS=8000

HUGGINGFACE_ENABLED=true
HUGGINGFACE_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
# Pick a model that is deployed for free Inference Providers and accepts images (see README, "Choosing a model").
HUGGINGFACE_MODEL=
# image-classification (real class probabilities) or chat (vision-language model, no confidence score)
HUGGINGFACE_TASK=image-classification

# Optional fallback. Skipped unless ALL FOUR are set. Set the AUTHORIZED flag to true only after
# confirming in your xAI console that this key/model may be used without unexpected charges.
GROK_ENABLED=false
GROK_ACCESS_AUTHORIZED=false
GROK_API_KEY=
GROK_MODEL=

# ---- Image storage (order = priority) -----------------------------------------
STORAGE_PRIORITY=r2,secondary
STORAGE_REPLICATE=false
SIGNED_URL_MINUTES=10

R2_ENABLED=true
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=agriscan-images
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
# Optional. Cloudflare sets this allowance; leave empty to show "Unknown".
R2_FREE_ALLOWANCE_BYTES=

SECONDARY_STORAGE_ENABLED=false
SECONDARY_STORAGE_KEY=
SECONDARY_STORAGE_SECRET=
SECONDARY_STORAGE_BUCKET=
SECONDARY_STORAGE_ENDPOINT=
SECONDARY_STORAGE_REGION=us-east-1
SECONDARY_STORAGE_PATH_STYLE=true
SECONDARY_STORAGE_LIMIT_BYTES=

# ---- Accounts, uploads, limits ---------------------------------------------------
DEFAULT_QUOTA_BYTES=1073741824
QUOTA_WARN_PERCENT=75
QUOTA_CRITICAL_PERCENT=90
UPLOAD_MAX_KB=8192
RATE_LOGIN_PER_MINUTE=5
RATE_UPLOADS_PER_MINUTE=10
RATE_AI_PER_HOUR=30
RATE_API_PER_MINUTE=120

# ---- Queue / scheduler -----------------------------------------------------------
QUEUE_CONNECTION=sync
# Secret (24+ chars) letting a free external cron service call POST /api/v1/internal/schedule. Empty = disabled.
INTERNAL_CRON_TOKEN=
HEALTH_STALE_MINUTES=30
CACHE_STORE=database
# Encrypted cookie sessions: no sessions table, nothing on Render's disk.
SESSION_DRIVER=cookie
SESSION_SECURE_COOKIE=true

# ---- Sign in with Google (optional) --------------------------------------------
# Create an OAuth client (type: Web application) in Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI: <APP_URL>/auth/google/callback   (must match exactly)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=   # optional; defaults to APP_URL + /auth/google/callback
